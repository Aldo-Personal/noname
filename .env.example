# Development only. Export with: set -a; source .env; set +a
APP_ENV=development
DATABASE_URL=postgres://infra:local-development-only@127.0.0.1:5432/infra?sslmode=disable
OIDC_ISSUER=http://localhost:8090/realms/infra-dev
OIDC_CLIENT_ID=infra-dashboard
PUBLIC_ORIGIN=http://localhost:5173
# Confidential providers additionally need OIDC_CLIENT_SECRET.
